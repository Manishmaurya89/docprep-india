{
  "name": "privacy-first-document-utilities",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first document preparation utilities for Indian online applications. Files are processed in the browser.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs && node scripts/copy-mediapipe.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs && node scripts/copy-mediapipe.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/copy-mediapipe.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "samples": "node scripts/generate-sample-files.mjs",
    "brand-assets": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "fflate": "0.8.3",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
